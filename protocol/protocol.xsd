<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema for the protocol.xml GigaScribe generates alongside protocol.json
  and protocol.html (item 11). Deliberately permissive: text content is
  unrestricted (a transcript can contain almost anything), and this only
  pins down the element structure and names so tooling can rely on them
  staying compatible across versions. verified is a tri-state string
  ("true" / "false" / "" for "not run"), not xs:boolean, since XSD's
  built-in boolean type has no empty/unknown state.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <xs:simpleType name="verifiedType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
      <xs:enumeration value=""/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="metadataType">
    <xs:sequence>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="sourceFile" type="xs:string"/>
      <xs:element name="processedAt" type="xs:string"/>
      <xs:element name="durationSeconds" type="xs:string"/>
      <xs:element name="model" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="participantsType">
    <xs:sequence>
      <xs:element name="participant" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="topicType">
    <xs:sequence>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="summary" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="topicsType">
    <xs:sequence>
      <xs:element name="topic" type="topicType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="decisionType">
    <xs:sequence>
      <xs:element name="text" type="xs:string"/>
      <xs:element name="speaker" type="xs:string"/>
      <xs:element name="timestampStart" type="xs:string" minOccurs="0"/>
      <xs:element name="timestampEnd" type="xs:string" minOccurs="0"/>
      <xs:element name="confidence" type="xs:string"/>
      <xs:element name="verified" type="verifiedType" minOccurs="0"/>
      <xs:element name="verificationReason" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="decisionsType">
    <xs:sequence>
      <xs:element name="decision" type="decisionType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="taskType">
    <xs:sequence>
      <xs:element name="text" type="xs:string"/>
      <xs:element name="owner" type="xs:string"/>
      <xs:element name="deadline" type="xs:string"/>
      <xs:element name="speaker" type="xs:string"/>
      <xs:element name="timestampStart" type="xs:string" minOccurs="0"/>
      <xs:element name="timestampEnd" type="xs:string" minOccurs="0"/>
      <xs:element name="confidence" type="xs:string"/>
      <xs:element name="verified" type="verifiedType" minOccurs="0"/>
      <xs:element name="verificationReason" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tasksType">
    <xs:sequence>
      <xs:element name="task" type="taskType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="itemListType">
    <xs:sequence>
      <xs:element name="item" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="protocol">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadata" type="metadataType"/>
        <xs:element name="participants" type="participantsType"/>
        <xs:element name="summary" type="xs:string"/>
        <xs:element name="topics" type="topicsType"/>
        <xs:element name="decisions" type="decisionsType"/>
        <xs:element name="tasks" type="tasksType"/>
        <xs:element name="openQuestions" type="itemListType"/>
        <xs:element name="risks" type="itemListType"/>
        <xs:element name="disagreements" type="itemListType"/>
        <xs:element name="nextSteps" type="itemListType"/>
        <xs:element name="unverifiedItems" type="itemListType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
