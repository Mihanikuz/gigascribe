GIGASCRIBE_SECRET_KEY=change-me-long-random-string
GIGASCRIBE_ADMIN_PASSWORD=change-me
GIGASCRIBE_DATA_DIR=/opt/gigascribe/data
GIGASCRIBE_MODELS_DIR=/opt/gigascribe/models
GIGASCRIBE_DEVICE=cpu
GIGASCRIBE_MAX_UPLOAD_BYTES=1073741824
# Runtime is offline for model loading. download_models.py switches HF_HUB_OFFLINE off only for download mode.
HF_HUB_OFFLINE=1
HF_TOKEN=
HF_HOME=/opt/gigascribe/models/huggingface
MPLCONFIGDIR=/opt/gigascribe/data/cache/matplotlib
XDG_CACHE_HOME=/opt/gigascribe/data/cache
HOST_UID=1000
HOST_GID=1000
