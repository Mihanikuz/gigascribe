GIGASCRIBE_SECRET_KEY=change-me-long-random-string
GIGASCRIBE_ADMIN_PASSWORD=change-me
# Нужен для скачивания/использования pyannote/speaker-diarization-3.1 после принятия условий модели на Hugging Face.
HF_TOKEN=
# Можно оставить значения по умолчанию: кэши и snapshot моделей будут в /opt/gigascribe/models.
GIGASCRIBE_MODELS_DIR=/opt/gigascribe/models
GIGASCRIBE_DATA_DIR=/opt/gigascribe/data
# Если скачали snapshot pyannote скриптом, укажите локальный путь:
GIGASCRIBE_PYANNOTE_MODEL=/opt/gigascribe/models/pyannote-speaker-diarization-3.1
# GigaAM загружается по имени, но его кэш хранится в GIGASCRIBE_MODELS_DIR/HF_HOME/TORCH_HOME.
GIGASCRIBE_GIGAAM_MODEL=v2_ctc
