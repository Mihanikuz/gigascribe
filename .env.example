GIGASCRIBE_SECRET_KEY=replace-with-a-long-random-string
GIGASCRIBE_ADMIN_PASSWORD=replace-with-a-strong-password
GIGASCRIBE_DATA_DIR=/opt/gigascribe/data
GIGASCRIBE_MODELS_DIR=/opt/gigascribe/models
# GigaScribe is CUDA-only; this value is not read for model/device selection
# (kept only for the entrypoint's CUDA smoke-test gate).
GIGASCRIBE_DEVICE=cuda
GIGASCRIBE_MAX_UPLOAD_BYTES=1073741824
# Raw audio (the uploaded original and the internal normalized WAV) older
# than this is deleted automatically; transcript, log, M4A, and FLAC exports
# are kept. Set to 0 to keep raw audio forever.
GIGASCRIBE_ORIGINAL_RETENTION_DAYS=14
# Runtime is offline for model loading. download_models.py switches HF_HUB_OFFLINE off only for download mode.
HF_HUB_OFFLINE=1
HF_TOKEN=
HF_HOME=/opt/gigascribe/models/huggingface
MPLCONFIGDIR=/opt/gigascribe/data/cache/matplotlib
XDG_CACHE_HOME=/opt/gigascribe/data/cache
HOST_UID=1000
HOST_GID=1000
# Optional add-on module: local-LLM meeting protocols. Off by default; the
# protocol/ package is never imported and no protocol tables/LLM are loaded
# unless this is "1". See README.md "Protocol module" for details.
GIGASCRIBE_PROTOCOL_ENABLED=0
# The rest only matter when the module is enabled; sensible defaults apply if unset.
#GIGASCRIBE_PROTOCOL_CHUNK_MINUTES=12
#GIGASCRIBE_PROTOCOL_CHUNK_OVERLAP_SECONDS=30
#GIGASCRIBE_PROTOCOL_TOPIC_SPLIT=1
#GIGASCRIBE_PROTOCOL_TEMPERATURE=0.2
#GIGASCRIBE_PROTOCOL_MAX_OUTPUT_TOKENS=2048
#GIGASCRIBE_PROTOCOL_MAX_RETRIES=2
#GIGASCRIBE_PROTOCOL_GLOSSARY_SUGGESTIONS=1
#GIGASCRIBE_PROTOCOL_DEFAULT_GLOSSARY_SCOPE=global
# Only used if the Ollama engine is selected in Протоколирование → Настройки.
#GIGASCRIBE_OLLAMA_URL=http://127.0.0.1:11434
